NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://inmycity:inmycity@localhost:5432/inmycity
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001

# Public web origin used to build shareable links (https://inmycity.app). Until this is set,
# share sheets send text only rather than a link to a domain that does not resolve.
EXPO_PUBLIC_WEB_BASE_URL=

# Google Maps keys for the embedded map. Android needs one or the map renders blank, so the
# app hides the map until it is set; iOS falls back to Apple Maps and needs none.
GOOGLE_MAPS_API_KEY_ANDROID=
GOOGLE_MAPS_API_KEY_IOS=

# Comma-separated browser origins allowed to call the API. Native app builds send no Origin
# header and are always allowed. Required in production; in development, localhost, LAN
# addresses and Expo tunnels are allowed automatically.
CORS_ALLOWED_ORIGINS=

# Set to "true" when running behind a load balancer or reverse proxy, so rate limiting keys
# on the real client IP from X-Forwarded-For rather than the proxy's.
TRUST_PROXY=false

# Request budgets, per client. Defaults shown.
API_RATE_LIMIT_PER_MINUTE=300
AI_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_DAY=200
# Reader-generated writes. Submissions are capped per hour because what they consume is a
# moderator's time, not CPU.
SUBMISSION_RATE_LIMIT_PER_HOUR=10
REACTION_RATE_LIMIT_PER_MINUTE=60

# ── Content operations ──────────────────────────────────────────────────────────────────
# Who may use /api/admin — comma separated. Unset means the admin routes answer 503 for
# everyone, which is the intended default: a missing configuration must never mean "anyone".
ADMIN_EMAILS=

# Opens Pulse posts to reader submissions. Leave unset until the moderation queue
# and the grievance process are actually staffed — decision 2 of the launch plan. While it is
# unset the submission routes answer 503 and the app hides the compose affordances entirely.
COMMUNITY_SUBMISSIONS_ENABLED=

# The grievance officer India's IT Rules require an intermediary to name and publish. The app
# reads these from /api/community-policy rather than hardcoding them, so the published contact
# and the one moderation actually uses cannot drift apart. Configure before enabling
# COMMUNITY_SUBMISSIONS_ENABLED.
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_EMAIL=
GRIEVANCE_OFFICER_ADDRESS=
GRIEVANCE_ACK_HOURS=24

# News ingestion. Every source in lib/news/allowlist.ts ships inactive and without a feed URL,
# because a feed endpoint is a fact to verify against the publisher rather than guess. Set the
# per-source override and flip the source active in the admin surface once you have checked it
# returns the right city's items. The slug is upper-snaked, e.g.:
# NEWS_FEED_MID_DAY_URL=https://www.mid-day.com/rss/mumbai
NEWS_INGEST_CITY=Mumbai

# Weekly content maintenance: how long an expired deal is kept before it is deleted outright.
CONTENT_MAINTENANCE_CITY=Mumbai
DEAL_EXPIRY_GRACE_DAYS=30

# Seeding guards. `pnpm run db:seed` is an idempotent upsert and refuses to run against
# NODE_ENV=production without ALLOW_PRODUCTION_SEED. The `--reset` flag deletes every content
# row, needs ALLOW_DESTRUCTIVE_SEED, and is refused in production outright.
# ALLOW_PRODUCTION_SEED=
# ALLOW_DESTRUCTIVE_SEED=

# Optional: enables the AI chat endpoint.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# OPENAI_BASE_URL=

# Optional: enables Google login.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: enables generic OIDC login at /api/login.
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
