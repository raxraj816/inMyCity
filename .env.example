NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://inmycity:inmycity@localhost:5432/inmycity
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001

# Public web origin used to build shareable links (https://inmycity.app). Until this is set,
# share sheets send text only rather than a link to a domain that does not resolve.
EXPO_PUBLIC_WEB_BASE_URL=

# Google Maps keys for the embedded map. Android needs one or the map renders blank, so the
# app hides the map until it is set; iOS falls back to Apple Maps and needs none.
GOOGLE_MAPS_API_KEY_ANDROID=
GOOGLE_MAPS_API_KEY_IOS=

# Comma-separated browser origins allowed to call the API. Native app builds send no Origin
# header and are always allowed. Required in production; in development, localhost, LAN
# addresses and Expo tunnels are allowed automatically.
CORS_ALLOWED_ORIGINS=

# Set to "true" when running behind a load balancer or reverse proxy, so rate limiting keys
# on the real client IP from X-Forwarded-For rather than the proxy's.
TRUST_PROXY=false

# Request budgets, per client. Defaults shown.
API_RATE_LIMIT_PER_MINUTE=300
AI_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_DAY=200

# Optional: enables the AI chat endpoint.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# OPENAI_BASE_URL=

# Optional: enables Google login.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: enables generic OIDC login at /api/login.
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
