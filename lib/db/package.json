{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "push": "DATABASE_URL=${DATABASE_URL:-postgres://inmycity:inmycity@localhost:5432/inmycity} drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "DATABASE_URL=${DATABASE_URL:-postgres://inmycity:inmycity@localhost:5432/inmycity} drizzle-kit push --force --config ./drizzle.config.ts",
    "bootstrap": "DATABASE_URL=${DATABASE_URL:-postgres://inmycity:inmycity@localhost:5432/inmycity} tsx src/bootstrap-cli.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.20.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.18.0",
    "drizzle-kit": "^0.31.9",
    "tsx": "catalog:"
  }
}
